# Copia este archivo a .env y rellena los valores.
# Nunca subas .env a un repositorio.

# Token del bot de Telegram (lo obtienes de @BotFather)
BOT_TOKEN=

# (Opcional) ID autorizado únicamente para el bootstrap inicial del System Owner.
# Se invalida automáticamente después del primer bootstrap.
SYSTEM_OWNER_BOOTSTRAP_ID=
OWNER_ID=

# Supabase compartido con Cerbero
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
