# Copia este archivo a .env y rellena solo los valores necesarios.
# Nunca subas .env a un repositorio.

# Obligatorio: token de este bot de Telegram (lo obtienes de @BotFather).
BOT_TOKEN=

# Opcional: ID del propietario. SYSTEM_OWNER_BOOTSTRAP_ID solo se usa para
# el bootstrap inicial del System Owner y permanece como identidad autorizada.
SYSTEM_OWNER_BOOTSTRAP_ID=
OWNER_ID=
# ID numérico verificado de una de las tres identidades administrativas
# (Alexiita). OWNER_ID, ALEXIITA_TELEGRAM_ID y SYSTEM_OWNER_BOOTSTRAP_ID
# tienen la misma jerarquía y los mismos permisos.
# No uses un username como identidad. Déjalo vacío hasta verificar el ID.
ALEXIITA_TELEGRAM_ID=

# Supabase compartido con CERBERO. Configúralo para las funciones que usan la
# base de datos; SERVICE_ROLE_KEY es un secreto de backend, nunca una clave
# pública ni una credencial para AFRODITA.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Opcionales: identidad de ZEUS en CERBERO y modo de ejecución de seguridad.
CERBERO_INSTANCE_ID=
SECURITY_EXECUTION_MODE=

# Enlaces y perfiles: dominios y usernames separados por comas.
# Ejemplo: LINK_WHITELIST=example.org,@official_channel
LINK_WHITELIST=
# Bloquea @mentions como posibles enlaces a canales; por defecto desactivado
# para no interrumpir menciones normales entre miembros.
LINK_FILTER_BLOCK_MENTIONS=false
# Términos explícitos separados por comas para filtrar nombres de perfil.
# No se puede obtener la biografía de un miembro mediante la Bot API.
PROFILE_BLOCKED_TERMS=
